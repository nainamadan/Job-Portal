# Copy to server/.env for local use. Set the same names in your hosting provider.
# Never place SMTP credentials in client/.env or variables starting with VITE_.
MONGODB_URI=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
JWT_SECRET=
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
GEMINI_API_KEY=
# Optional override for learning roadmaps; defaults to the existing gemini-3.8-flash model.
GEMINI_ROADMAP_MODEL=
# Automatically used if the primary is busy, unavailable, or times out.
# Defaults to gemini-3.1-flash-lite; both attempts share the 90-second deadline.
GEMINI_ROADMAP_FALLBACK_MODEL=
SENTRY_DSN=
PORT=5000
FRONTEND_URL=http://localhost:5173

# SMTP provider: use a sender address authorized by that provider.
SMTP_HOST=
SMTP_PORT=587
# false for STARTTLS on 587; true for TLS on 465.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Alternative: Gmail with an App Password, when SMTP is not configured.
GMAIL_USER=
GMAIL_PASS=
